---
import FieldTestForm from "./FieldTestForm.jsx";
---

<section
  id="testing"
  class="relative z-30 min-h-screen overflow-hidden bg-near-black px-5 py-20 text-warm-white sm:px-8 sm:py-24 lg:px-12 lg:py-28 xl:px-16"
>
  <div
    class="mx-auto grid min-h-[calc(100vh-10rem)] max-w-[1600px] lg:grid-cols-[0.9fr_1.1fr]"
  >

    <!-- ========================================= -->
    <!-- LEFT / CONTEXT -->
    <!-- ========================================= -->

    <div
      class="flex flex-col justify-between border-b border-warm-white/10 pb-14 lg:border-b-0 lg:border-r lg:pb-0 lg:pr-16 xl:pr-24"
    >

      <!-- Top -->
      <div>

        <div class="flex items-center justify-between">
          <p
            class="font-supporting text-[10px] uppercase tracking-[0.18em] text-chartreuse sm:text-xs"
          >
            Pre-Launch Field Testing
          </p>

          <span
            class="font-supporting text-[9px] uppercase tracking-[0.18em] text-warm-white/25 sm:hidden"
          >
            01 / 01
          </span>
        </div>


        <!-- Main heading -->
        <h2
          class="mt-8 max-w-xl font-heading text-[clamp(3.5rem,7vw,6.5rem)] font-extrabold uppercase leading-[0.78] tracking-[-0.07em]"
        >
          <span class="block">Fish it</span>

          <span class="block">before we</span>

          <span class="block text-chartreuse">launch.</span>
        </h2>


        <!-- Intro -->
        <div
          class="mt-10 max-w-lg space-y-5 font-body text-sm leading-6 text-warm-white/50 sm:mt-12 sm:text-base sm:leading-7"
        >
          <p class="font-semibold text-warm-white/80">
            We're looking for anglers who fish.
          </p>

          <p>
            YONAH is inviting anglers who fish from boats, kayaks, and the
            bank to put early Razor prototypes on the water.
          </p>

          <p>
            Fish it like you normally fish. Tell us what works. Tell us
            what doesn't.
          </p>
        </div>

      </div>


      <!-- Bottom meta -->
      <div
        class="mt-12 flex items-center justify-between border-t border-warm-white/10 pt-5 lg:mt-16"
      >
        <span
          class="font-supporting text-[9px] uppercase tracking-[0.16em] text-warm-white/30 sm:text-[10px]"
        >
          Razor Pre-Launch Program
        </span>

        <span
          class="hidden font-supporting text-[9px] uppercase tracking-[0.16em] text-warm-white/20 sm:block"
        >
          YONAH / 2026
        </span>
      </div>

    </div>


    <!-- ========================================= -->
    <!-- RIGHT / FORM -->
    <!-- ========================================= -->

    <div
      class="flex items-center pt-14 lg:pl-16 lg:pt-0 xl:pl-24"
    >

      <div class="w-full max-w-xl">

        <!-- Form heading -->
        <div class="mb-4 sm:mb-8">

          <h2
            class="font-heading text-4xl font-extrabold uppercase leading-[0.85] tracking-[-0.05em] sm:text-5xl"
          >
            Put it
            <span class="text-chartreuse ml-1.5"> to work.</span>
          </h2>

          <p
            class="mt-4 max-w-sm font-body text-sm leading-6 text-warm-white/40"
          >
            Tell us a little about how you fish. Selected anglers will
            get the chance to put an early Razor prototype on the water.
          </p>

        </div>


        <!-- Form -->
        <div
          class="border-t border-warm-white/10 pt-8 sm:pt-10"
        >
          <FieldTestForm client:load />
        </div>

      </div>

    </div>

  </div>
</section>