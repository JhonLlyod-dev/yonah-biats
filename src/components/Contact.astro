---
import FieldTestForm from "./FieldTestForm.jsx";
---

<section
  id="testing"
  class="min-h-screen snap-start relative z-30  bg-near-black px-5 py-24 pb-0 text-warm-white sm:px-8 lg:px-12 xl:px-16"
>
  <div class="mx-auto grid max-w-[1600px] gap-16 lg:grid-cols-2 lg:items-start lg:gap-24 xl:gap-32">

    <!-- CONTEXT -->
    <div class="max-w-xl">

      <p class="font-supporting text-xs uppercase tracking-[0.16em] text-warm-white/45">
        Pre-Launch Field Testing
      </p>

      <h2 class="mt-5 font-heading text-5xl font-bold uppercase leading-[0.9] tracking-[-0.06em] sm:text-6xl lg:text-7xl">
        Fish it
        <br />
        before we
        <span class="ml-2 text-chartreuse">launch.</span>
      </h2>

      <div class="mt-10 max-w-lg space-y-6 font-body text-base leading-7 text-warm-white/55 sm:text-lg">
        <p>We're looking for anglers who fish.</p>
        <p>
          YONAH is inviting anglers who fish from boats, kayaks, and the
          bank to put early Razor prototypes on the water.
        </p>
        <p>
          Fish it like you normally fish. Tell us what works. Tell us
          what doesn't.
        </p>
      </div>

      <div class="mt-12 border-t border-warm-white/10 pt-5 font-supporting text-[10px] uppercase tracking-[0.14em] text-warm-white/35">
        Razor Pre-Launch Program
      </div>

    </div>

    <!-- FORM (client-side interactive, hydrated) -->
    <div class="p-6 text-warm-white sm:p-8 lg:p-10 xl:p-12">

      <div class="mb-10">
        <h2 class="mt-3 font-heading text-3xl font-bold uppercase leading-none tracking-[-0.04em] sm:text-4xl">
          Put it to work.
        </h2>
      </div>

      <FieldTestForm client:load />

    </div>

  </div>
</section>