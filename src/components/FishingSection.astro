---
import { Image } from "astro:assets";
---

<section
  id="bait"
  aria-label="Where Razor performs"
  class="relative z-30 min-h-screen overflow-hidden bg-warm-white text-near-black"
>
  <div class="grid min-h-screen lg:grid-cols-[0.95fr_1.05fr]">

    <!-- ========================================= -->
    <!-- IMAGE -->
    <!-- ========================================= -->

    <div
      class="relative min-h-[55svh] overflow-hidden bg-steel-gray/20 lg:min-h-screen"
    >
      <!-- Image -->
      <Image
        src="/fishing.png"
        alt="Angler fishing on the water"
        width={1200}
        height={1200}
        class="absolute inset-0 h-full w-full object-cover"
      />

      <!-- Image overlay -->
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-near-black/[0.08]"
      ></div>

      <!-- Subtle green glow -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute bottom-[-15%] left-[-10%] h-[45%] w-[45%] rounded-full bg-chartreuse/[0.12] blur-[100px]"
      ></div>

      <!-- Image label -->
      <div
        class="absolute bottom-6 left-5 sm:bottom-8 sm:left-8 lg:bottom-10 lg:left-10"
      >
        <span
          class="font-supporting text-[9px] uppercase tracking-[0.2em] text-warm-white/70 sm:text-[10px]"
        >
          BUILT TO STAY TIED ON
        </span>
      </div>
    </div>


    <!-- ========================================= -->
    <!-- CONTENT -->
    <!-- ========================================= -->

    <div
      class="flex items-center px-6 py-16 sm:px-10 sm:py-20 lg:px-14 lg:py-24 xl:px-20 2xl:px-28"
    >
      <div class="w-full max-w-2xl">

        <!-- Eyebrow -->
        <div class="flex items-center gap-3">
          <span
            class="h-1.5 w-1.5 rounded-full bg-chartreuse"
          ></span>

          <span
            class="font-supporting text-[10px] uppercase tracking-[0.18em] text-near-black/45 sm:text-xs"
          >
            A CONFIDENCE BAIT FOR ANY ANGLER
          </span>
        </div>


        <!-- Heading -->
        <h2
          class="mt-8 font-heading text-[clamp(4rem,8vw,8rem)] font-extrabold uppercase leading-[0.78] tracking-[-0.07em]"
        >
          <span class="block">Boat.</span>

          <span class="block">Kayak.</span>

          <span class="block text-chartreuse">Bank.</span>
        </h2>




        <!-- Supporting copy -->
        <div class="mt-6 flex max-w-xl items-start gap-4">
          <span
            class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-chartreuse"
          ></span>

          <p
            class="font-body text-sm leading-6 text-near-black/60 sm:text-base sm:leading-7"
          >
            Whether you’re running a pattern from a boat or making the most
            of one stretch of bank, Razor is built to be the crankbait you
            can keep tied on when you just need to get bit.
          </p>
        </div>


        <!-- Bottom meta -->
        <div
          class="mt-10 flex items-center justify-between border-t border-near-black/10 pt-5 sm:mt-14"
        >
          <span
            class="font-supporting text-[9px] uppercase tracking-[0.18em] text-near-black/35 sm:text-[10px]"
          >
            ONE BAIT
          </span>

          <span
            class="font-supporting text-[9px] uppercase tracking-[0.18em] text-near-black/35 sm:text-[10px]"
          >
            ANY WATER
          </span>
        </div>

      </div>
    </div>

  </div>
</section>