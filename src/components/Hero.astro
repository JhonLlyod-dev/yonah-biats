---
---

<section
  id="hero"
  aria-label="YONAH Razor introduction"
  class="relative flex min-h-[100svh] flex-col overflow-hidden bg-near-black text-warm-white"
>
  <!-- Ambient product glow -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-[34%] h-[70vw] w-[70vw] max-h-[850px] max-w-[850px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-chartreuse/[0.04] blur-[120px] sm:top-[38%]"
  ></div>

  <!-- Secondary glow directly behind product -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-[38%] h-[280px] w-[280px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-chartreuse/[0.045] blur-[80px] sm:h-[400px] sm:w-[400px] lg:h-[500px] lg:w-[500px]"
  ></div>

  <div
    class="relative z-10 mx-auto flex min-h-svh w-full max-w-[1800px] flex-1 flex-col px-5 pb-6 pt-20 sm:px-8 sm:pb-8 sm:pt-24 lg:px-12 lg:pb-8 lg:pt-24 xl:px-16"
  >

    <!-- ========================================= -->
    <!-- TOP META -->
    <!-- ========================================= -->

    <div class="flex w-full items-start justify-between">

      <!-- Left label -->
      <span
        class="font-supporting text-[9px] uppercase leading-[1.6] tracking-[0.18em] text-chartreuse sm:text-[10px] sm:text-xs"
      >
        Introducing
        <br />
        The Razor
      </span>

      <!-- Right label -->
      <span
        class="text-right font-supporting text-[9px] uppercase leading-[1.6] tracking-[0.16em] text-warm-white/35 sm:text-[10px] sm:text-xs"
      >
        Flatside Crankbait
        <br />
        Pre-Launch / 2026
      </span>

    </div>


    <!-- ========================================= -->
    <!-- PRODUCT -->
    <!-- ========================================= -->

    <div
      class="relative flex flex-1 items-center justify-center"
    >

      <!-- Decorative rings -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute left-1/2 top-1/2 h-[180px] w-[180px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-chartreuse/[0.08] sm:h-[280px] sm:w-[280px] lg:h-[380px] lg:w-[380px]"
      ></div>

      <div
        aria-hidden="true"
        class="pointer-events-none absolute left-1/2 top-1/2 h-[120px] w-[120px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-chartreuse/[0.06] sm:h-[200px] sm:w-[200px] lg:h-[280px] lg:w-[280px]"
      ></div>

      <!-- 3D PRODUCT -->
      <div
        class="relative z-10 flex h-[30vh] w-full max-w-[300px] items-center justify-center sm:h-[20vh] sm:max-w-[420px] lg:h-[40vh] lg:max-w-[520px]"
      >
        <!-- 3D PRODUCT IMAGE -->
        <img
          src="/yonah-3.png"
          alt="YONAH Razor Flatside Crankbait"
          class="md:hidden h-full w-full object-contain"
          loading="eager"
        />
      </div>

    </div>


    <!-- ========================================= -->
    <!-- BOTTOM CONTENT -->
    <!-- ========================================= -->

    <div class="w-full">

      <!-- Eyebrow -->
      <p
        class="mb-2 font-supporting text-[9px] uppercase tracking-[0.2em] text-warm-white/40 sm:mb-3 sm:text-[10px] sm:text-xs"
      >
        Confidence bait for every angler
      </p>


      <!-- Heading -->
      <h1
        class="min-w-0 font-heading text-[clamp(2.5rem,7.5vw,6rem)] font-extrabold uppercase leading-[0.8] tracking-[-0.07em]"
      >
        <span class="block">Fish</span>

        <span class="block">
          <span class="text-chartreuse">with</span>
          confidence.
        </span>
      </h1>


      <!-- Supporting copy -->
      <div
        class="mt-4 flex max-w-xl items-start gap-3 border-t border-warm-white/10 pt-3 sm:mt-5 sm:gap-4 sm:pt-4"
      >
        <span
          class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-chartreuse"
        ></span>

        <p
          class="font-body text-xs leading-5 text-warm-white/45 sm:text-sm sm:leading-6"
        >
          A razor-thin flatside built to fish bigger than its profile.
        </p>
      </div>

    </div>

  </div>
</section>