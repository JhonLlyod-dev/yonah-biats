---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
---

<section class="relative overflow-hidden bg-near-black text-warm-white">
	<!-- Decorative accent -->
	<div
		class="pointer-events-none absolute -right-40 top-1/2 h-[500px] w-[500px] -translate-y-1/2 rounded-full bg-chartreuse/10 blur-3xl"
	></div>

	<div
		class="pointer-events-none absolute bottom-0 left-0 h-px w-full bg-steel-gray/20"
	></div>

	<div class="relative mx-auto flex min-h-[80vh] max-w-7xl items-center px-6 py-24 lg:px-8">
		<div class="max-w-5xl">
			<p
				class="mb-6 font-supporting text-sm font-medium uppercase tracking-[0.25em] text-chartreuse"
			>
				Performance Fishing Gear
			</p>

			<h1
				class="font-heading text-6xl font-extrabold uppercase leading-[0.9] tracking-[-0.04em] sm:text-7xl lg:text-9xl"
			>
				Built to
				<span class="text-chartreuse">Perform.</span>
			</h1>

			<p
				class="mt-8 max-w-xl font-body text-base leading-7 text-steel-gray sm:text-lg"
			>
				High-performance baits designed with purpose, tested in real
				conditions, and built for anglers who expect more.
			</p>

			<div class="mt-10 flex flex-wrap gap-4">
				<a
					href="#products"
					class="bg-chartreuse px-6 py-4 font-supporting text-sm font-medium uppercase tracking-wider text-near-black transition-colors hover:bg-warm-white"
				>
					Explore Products
				</a>

				<a
					href="#contact"
					class="border border-warm-white/30 px-6 py-4 font-supporting text-sm font-medium uppercase tracking-wider text-warm-white transition-colors hover:border-chartreuse hover:text-chartreuse"
				>
					Test Our Products
				</a>
			</div>

			<div class="mt-16 flex items-center gap-4">
				<div class="h-px w-12 bg-chartreuse"></div>

				<span
					class="font-supporting text-xs uppercase tracking-[0.2em] text-steel-gray"
				>
					Designed for the strike
				</span>
			</div>
		</div>
	</div>
</section>
