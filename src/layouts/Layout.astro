---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

const siteName = "YONAH Bait Company";
const siteUrl = "https://yonahbaits.com";
const ogImage = `/og-image.webp`;
const title = "YONAH Bait Company | Confidence Bait for Every Angler";
const description = "YONAH Bait Company creates purpose-built fishing lures designed to give anglers confidence on the water. Meet the Razor, a compact, silent flatside crankbait built for versatility.";
const keywords = ["YONAH Bait Company", "YONAH Baits", "Razor crankbait", "flatside crankbait", "fishing lures", "bass fishing lures", "finesse crankbait", "silent crankbait", "fishing bait"];
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(", ")} />
    <meta name="author" content={siteName} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0D0D0D" />
    <meta name="color-scheme" content="dark" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="YONAH Bait Company — fishing lures designed for confidence on the water" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="YONAH Bait Company — fishing lures designed for confidence on the water" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Inter:wght@400;500&family=Roboto+Condensed:wght@400;500&display=swap" rel="stylesheet" />

    <ClientRouter />
  </head>

  <body>

    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background: var(--color-near-black);
  }
</style>