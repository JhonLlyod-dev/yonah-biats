---
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Product from '../components/Product.astro';
import Contact from '../components/Contact.astro';
import FishingSection from '../components/FishingSection.astro';
import Design from '../components/Design.astro';
import Scene from '../components/BaitScene.jsx';
import Loader from '../components/Loader.jsx';
import InteractRazorButton from '../components/Try.jsx';
---

<Layout>
  <Loader client:media="(min-width: 640px)" />
  <Header client:load />

  <InteractRazorButton client:load />

  <div id="three-scroll" class="relative h-[300vh] w-full">


    <div class="absolute inset-0 z-40">
      <Scene client:media="(min-width: 768px)" />
    </div>

    <Hero />
    <Product />
    <Design />
    <FishingSection />
    <Contact />
    <Footer />

  </div>
</Layout>